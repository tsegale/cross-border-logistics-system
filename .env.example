# Copy to .env and change every secret before running anything outside your laptop.
#   cp .env.example .env
# docker compose reads .env automatically and refuses to start if a required value is missing.
# CI replaces every change-me value.

# --- Databases: one per service (ADR 0001) ---
BANKING_DB_USER=banking
LOGISTICS_DB_USER=logistics
NOTIFICATION_DB_USER=notification
# Passwords and client secrets are not here: python scripts/generate_secrets.py writes them into secrets/ (ADR 0019).

# Daily reference rates (ADR 0034). The real sources by default; CI and the fire drill use the partner simulator:
#   ECB_BASE_URL=http://partner-simulator:8090/ecb
#   BON_RATES_URL=http://partner-simulator:8090/bon/ratestable/api/rates
ECB_BASE_URL=https://data-api.ecb.europa.eu
BON_RATES_URL=https://services.bon.com.na/ratestable/api/rates
