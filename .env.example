# Copy to .env and change every secret before running anything outside your laptop.
#   cp .env.example .env
# docker compose reads .env automatically and refuses to start if a required value is missing.
# CI replaces every change-me value.

# --- Databases: one per service (ADR 0001) ---
BANKING_DB_USER=banking
BANKING_DB_PASSWORD=change-me-banking
LOGISTICS_DB_USER=logistics
LOGISTICS_DB_PASSWORD=change-me-logistics
