# Normalise line endings: LF in the repo and working tree (shell scripts and Dockerfiles break with CRLF).
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.jar binary
*.png binary
*.jpg binary
# Responses recorded from outside APIs (ADR 0034) keep the exact bytes they were sent with: the ECB answers CRLF.
banking-service/src/test/resources/ecb/** -text
banking-service/src/test/resources/bon/** -text
