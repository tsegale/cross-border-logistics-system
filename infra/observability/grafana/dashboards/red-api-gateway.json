{
  "uid": "red-api-gateway",
  "title": "RED: api-gateway",
  "description": "Rate, errors and duration of api-gateway's requests (docs/slo.md). Latency panels show exemplars: a dot links to a trace that landed in that bucket.",
  "tags": [
    "freightflow",
    "red"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "utc",
  "panels": [
    {
      "type": "row",
      "title": "Rate, errors, duration",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second",
      "description": "By endpoint.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "links": [
        {
          "title": "Traces of api-gateway in Tempo",
          "targetBlank": true,
          "url": "/explore?schemaVersion=1&panes={\"t\":{\"datasource\":\"tempo\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"tempo\",\"uid\":\"tempo\"},\"queryType\":\"traceql\",\"query\":\"{resource.service.name=\\\"api-gateway\\\"}\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}"
        },
        {
          "title": "Logs of api-gateway in Loki",
          "targetBlank": true,
          "url": "/explore?schemaVersion=1&panes={\"l\":{\"datasource\":\"loki\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"loki\",\"uid\":\"loki\"},\"expr\":\"{service_name=\\\"api-gateway\\\"}\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count{service=\"api-gateway\"}[$__rate_interval]))",
          "legendFormat": "{{routeId}}",
          "exemplar": false
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Server errors (5xx share)",
      "description": "Share of requests that ended in a server error.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "links": [
        {
          "title": "Traces of api-gateway in Tempo",
          "targetBlank": true,
          "url": "/explore?schemaVersion=1&panes={\"t\":{\"datasource\":\"tempo\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"tempo\",\"uid\":\"tempo\"},\"queryType\":\"traceql\",\"query\":\"{resource.service.name=\\\"api-gateway\\\"}\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}"
        },
        {
          "title": "Logs of api-gateway in Loki",
          "targetBlank": true,
          "url": "/explore?schemaVersion=1&panes={\"l\":{\"datasource\":\"loki\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"loki\",\"uid\":\"loki\"},\"expr\":\"{service_name=\\\"api-gateway\\\"} | detected_level=\\\"error\\\"\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.005
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count{service=\"api-gateway\",outcome=\"SERVER_ERROR\"}[$__rate_interval])) / sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count{service=\"api-gateway\"}[$__rate_interval]))",
          "legendFormat": "{{routeId}}",
          "exemplar": false
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 latency",
      "description": "95th percentile from the histogram buckets, with exemplars.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "links": [
        {
          "title": "Traces of api-gateway in Tempo",
