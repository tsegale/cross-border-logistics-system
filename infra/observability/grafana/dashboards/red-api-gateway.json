      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, routeId) (rate(spring_cloud_gateway_requests_seconds_bucket{service=\"api-gateway\"}[$__rate_interval])))",
          "legendFormat": "{{routeId}}",
          "exemplar": true
