# Turns on OpenTelemetry export in every service and starts the observability stack (ADR 0030 to 0033):
#   docker compose --env-file .env --env-file infra/observability/observability.env --profile observability up -d
# Without this file the services still trace (ids in logs and outbox rows) but export nothing.
SPRING_PROFILES_ACTIVE=otlp
# HTTPS, the collector verified against the internal root (ADR 0040).
OTLP_ENDPOINT=https://otel-collector:4318
# Tail sampling keeps every error, slow and money-moving trace, and this share of the rest: everything in dev and CI.
# A production deployment sets 10 (ADR 0031).
TAIL_SAMPLING_PERCENTAGE=100
DEPLOYMENT_ENVIRONMENT=local
