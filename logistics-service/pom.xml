<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.freightflow</groupId>
    <artifactId>logistics-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>logistics-service</name>
    <description>Freight quotes, shipments and tracking on the Walvis Bay to Hamburg corridor</description>

    <properties>
        <java.version>21</java.version>
        <!-- springdoc 3.2.1 brings swagger-core 3.0.0, which moved to Jackson 3; the contract tests' request validator
             (swagger-parser 2.1.x, newest 2.1.49) is built on swagger-core 2.2.x and Jackson 2, and fails with
             NoSuchMethodError on Yaml.mapper(). One artifact cannot be both: logistics stays on 3.2.0 until
             swagger-parser moves to swagger-core 3. Banking has no validator and takes 3.2.1. -->
        <springdoc.version>3.2.0</springdoc.version>
        <jacoco.version>0.8.16</jacoco.version>
        <!-- One seed orders test classes (Surefire) and test methods (JUnit). It changes every build; Surefire
             prints it, and -Dsurefire.runOrder.random.seed=<seed> replays that exact order. -->
        <maven.build.timestamp.format>yyMMddHHmmss</maven.build.timestamp.format>
        <surefire.runOrder.random.seed>${maven.build.timestamp}</surefire.runOrder.random.seed>
        <wiremock.version>3.13.2</wiremock.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <swagger-request-validator.version>3.0.0</swagger-request-validator.version>
        <testcontainers-keycloak.version>4.4.0</testcontainers-keycloak.version>
        <!-- The OpenTelemetry Logback appender and the OpenTelemetry API that release is built on (the opentelemetry-api
             dependency in its pom). Dependabot ignores the appender: both move by hand with a Spring Boot upgrade, and
             the enforcer fails the build unless the API equals the one Boot manages (${opentelemetry.version}). -->
        <opentelemetry-logback-appender.version>2.34.0-alpha</opentelemetry-logback-appender.version>
        <opentelemetry-logback-appender.built-on>1.68.0</opentelemetry-logback-appender.built-on>
        <!-- Test only: a throwaway CA for the broker's TLS listener (KafkaBroker, ADR 0039). -->
        <bouncycastle.version>1.87</bouncycastle.version>
    </properties>

    <dependencies>
        <!-- Web, validation, persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Validates the relayed token itself, its own audience (ADR 0017) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Its own client-credentials token for banking (ADR 0019) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Schema migrations. Spring Boot 4 needs the starter: flyway-core alone no longer auto-configures. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Events on Kafka (ADR 0003); topics declared by the owning service (ADR 0022). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- HTTP service clients (@HttpExchange on RestClient) for calls to banking-service -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- Circuit breaker and bulkheads around banking-service calls (ADR 0013) -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!-- OpenAPI document and Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Health probes and Prometheus metrics -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Traces and logs over OTLP (ADR 0030): Spring Boot's own OpenTelemetry support, no Java agent. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <!-- Logs over OTLP are not part of Spring Boot. Only "-alpha" releases exist. -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
            <version>${opentelemetry-logback-appender.version}</version>
        </dependency>

        <!-- Tests: integration tests run on real Postgres in Testcontainers, never H2 -->
        <!-- Reads the spans a test causes (TestSpans); the version comes from Spring Boot's OpenTelemetry BOM. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @AutoConfigureTracing: without it a Spring Boot test exports no span, not even to TestSpans. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Stand-in for banking-service in tests; the standalone jar shades its own Jetty -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Validates every banking stub against banking's committed OpenAPI document (ADR 0014) -->
        <dependency>
            <groupId>com.atlassian.oai</groupId>
            <artifactId>swagger-request-validator-core</artifactId>
            <version>${swagger-request-validator.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Network faults between logistics and a real banking-service container (ADR 0013) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-toxiproxy</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The realm and the client-credentials path against a real Keycloak (ADR 0016, ADR 0019) -->
        <dependency>
            <groupId>com.github.dasniko</groupId>
            <artifactId>testcontainers-keycloak</artifactId>
            <version>${testcontainers-keycloak.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- The realm the stack imports, so the Keycloak tests import exactly that file -->
            <testResource>
                <directory>../infra/keycloak/realm</directory>
                <targetPath>keycloak</targetPath>
            </testResource>
        </testResources>
        <plugins>
            <!-- OpenTelemetry's artifacts must agree, or the context fails to start with a NoClassDefFoundError deep
                 inside the SDK's auto-configuration (Dependabot #8 and #11). These rules fail the build first, saying
                 which version to move. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>opentelemetry-versions-agree</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- Exact equality catches both directions: an appender older than Boot's OpenTelemetry (#11) and one
                                     built on a newer API (#8). -->
                                <requireProperty>
                                    <property>opentelemetry.version</property>
                                    <regex>\Q${opentelemetry-logback-appender.built-on}\E</regex>
                                    <regexMessage>Spring Boot manages OpenTelemetry ${opentelemetry.version}, but opentelemetry-logback-appender-1.0 ${opentelemetry-logback-appender.version} is built on ${opentelemetry-logback-appender.built-on}. Move the appender to the release whose pom depends on opentelemetry-api ${opentelemetry.version}, and set opentelemetry-logback-appender.built-on to match.</regexMessage>
                                </requireProperty>
                                <requireSameVersions>
                                    <dependencies>
                                        <dependency>io.opentelemetry:opentelemetry-api</dependency>
                                        <dependency>io.opentelemetry:opentelemetry-context</dependency>
                                        <dependency>io.opentelemetry:opentelemetry-sdk</dependency>
                                        <dependency>io.opentelemetry:opentelemetry-sdk-common</dependency>
                                        <dependency>io.opentelemetry:opentelemetry-sdk-logs</dependency>
                                        <dependency>io.opentelemetry:opentelemetry-sdk-trace</dependency>
                                        <dependency>io.opentelemetry:opentelemetry-sdk-metrics</dependency>
                                    </dependencies>
                                </requireSameVersions>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- No test may depend on another test's data or run order -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <runOrder>random</runOrder>
                    <properties>
                        <configurationParameters>
                            junit.jupiter.testmethod.order.default = org.junit.jupiter.api.MethodOrderer$Random
                            junit.jupiter.execution.order.random.seed = ${surefire.runOrder.random.seed}
                            junit.jupiter.extensions.autodetection.enabled = true
                        </configurationParameters>
                    </properties>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/*Application.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
