{
  "components" : {
    "schemas" : {
      "AccountDiscrepancy" : {
        "properties" : {
          "accountId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "accountNumber" : {
            "type" : "string"
          },
          "computedBalance" : {
            "type" : "number"
          },
          "currency" : {
            "type" : "string"
          },
          "difference" : {
            "type" : "number"
          },
          "materialisedBalance" : {
            "type" : "number"
          }
        },
        "type" : "object"
      },
      "AccountResponse" : {
        "description" : "Ledger account state and materialised balance",
        "properties" : {
          "accountNumber" : {
            "description" : "Human account number with ISO 7064 MOD 97-10 check digits",
            "example" : "FF49NAD000001000",
            "type" : "string"
          },
          "availableBalance" : {
            "description" : "Ledger balance minus active holds: what a transfer or a new hold may use",
            "example" : 11975.25,
            "type" : "number"
          },
          "createdAt" : {
            "description" : "Creation timestamp (UTC)",
            "example" : "2026-11-07T18:00:00Z",
            "format" : "date-time",
            "type" : "string"
          },
          "currency" : {
            "description" : "ISO 4217 currency code",
            "example" : "NAD",
            "type" : "string"
          },
          "holderReference" : {
            "description" : "Holder reference",
            "example" : "CUST-NAM-WALVIS-001",
            "type" : "string"
          },
          "id" : {
            "description" : "Time-ordered UUIDv7 identifier",
            "example" : "01930000-0000-7000-8000-000000001000",
            "format" : "uuid",
            "type" : "string"
          },
          "ledgerBalance" : {
            "description" : "Ledger balance: the sum of the account's postings, rounded HALF_EVEN",
            "example" : 12500.0,
            "type" : "number"
          },
          "status" : {
            "description" : "Account lifecycle status",
            "enum" : [ "ACTIVE", "FROZEN", "CLOSED" ],
            "example" : "ACTIVE",
            "type" : "string"
          },
          "type" : {
            "description" : "Account type",
            "enum" : [ "CUSTOMER", "CLEARING", "FREIGHT_REVENUE", "FX_POSITION" ],
            "example" : "CUSTOMER",
            "type" : "string"
          },
          "updatedAt" : {
            "description" : "Last balance update timestamp (UTC)",
            "example" : "2026-11-07T18:05:00Z",
            "format" : "date-time",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "CaptureHoldRequest" : {
        "description" : "Capture a hold, fully or in part. A hold is captured at most once; the rest is released.",
        "properties" : {
          "amount" : {
            "description" : "Amount to capture in the hold's charge currency; omitted means the full amount",
            "example" : 524.75,
            "minimum" : 0.01,
            "type" : [ "number", "null" ]
          }
        },
        "type" : "object"
      },
      "CreateAccountRequest" : {
        "description" : "Request to open a customer ledger account in a supported ISO 4217 currency",
        "properties" : {
          "currency" : {
            "description" : "ISO 4217 3-letter currency code",
            "example" : "NAD",
            "maxLength" : 3,
            "minLength" : 3,
            "type" : "string"
          },
          "holderReference" : {
            "description" : "External customer or company reference",
            "example" : "CUST-NAM-WALVIS-001",
            "maxLength" : 120,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "currency", "holderReference" ],
        "type" : "object"
      },
      "CreateFxQuoteRequest" : {
        "properties" : {
          "buyAmount" : {
            "exclusiveMinimum" : 0,
            "type" : "number"
          },
          "buyCurrency" : {
            "minLength" : 1,
            "type" : "string"
          },
          "sellAmount" : {
            "exclusiveMinimum" : 0,
            "type" : "number"
          },
          "sellCurrency" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "buyCurrency", "sellCurrency" ],
        "type" : "object"
      },
      "CreateHoldRequest" : {
        "description" : "Reserve funds on a customer account for a charge that is captured later",
        "properties" : {
          "amount" : {
            "description" : "Amount to reserve, in the charge currency",
            "example" : 524.75,
            "minimum" : 0.01,
            "type" : "number"
          },
          "currency" : {
            "description" : "ISO 4217 charge currency. If it differs from the payer account's, banking converts at its own rate and locks that rate on the hold",
            "example" : "EUR",
            "maxLength" : 3,
            "minLength" : 3,
            "type" : "string"
          },
          "expiresAt" : {
            "description" : "When the hold lapses if not captured; default 7 days, at most 30",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "payerAccount" : {
            "description" : "Payer account number (MOD 97-10 check digits) or UUID",
            "example" : "FF49EUR000001002",
            "minLength" : 1,
            "type" : "string"
          },
          "reference" : {
            "description" : "What the hold is for",
            "example" : "SHIPMENT FF-00010011-0",
            "maxLength" : 160,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "amount", "currency", "payerAccount", "reference" ],
        "type" : "object"
      },
      "CreateTransferRequest" : {
        "description" : "Request to transfer funds between two ledger accounts",
        "properties" : {
          "amount" : {
            "description" : "Transfer amount in the specified currency",
            "example" : 2000.0,
            "minimum" : 0.01,
            "type" : "number"
          },
          "currency" : {
            "description" : "ISO 4217 currency code of amount",
            "example" : "NAD",
            "maxLength" : 3,
            "minLength" : 3,
            "type" : "string"
          },
          "fxQuoteId" : {
            "description" : "FX quote ID (required when sourceAccount and targetAccount have different currencies)",
            "example" : "01930000-0000-7000-8000-000000002000",
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "reference" : {
            "description" : "Payment or invoice reference",
            "example" : "INV-NAWVB-DEHAM-2026-0042",
            "maxLength" : 160,
            "minLength" : 0,
            "type" : "string"
          },
          "sourceAccount" : {
            "description" : "Source account number (with MOD 97-10 check digits) or UUID",
            "example" : "FF83NAD000001000",
            "minLength" : 1,
            "type" : "string"
          },
          "targetAccount" : {
            "description" : "Target account number (with MOD 97-10 check digits) or UUID",
            "example" : "FF14EUR000001001",
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "amount", "currency", "reference", "sourceAccount", "targetAccount" ],
        "type" : "object"
      },
      "CurrencyTrialBalance" : {
        "properties" : {
          "balanced" : {
            "type" : "boolean"
          },
          "currency" : {
            "type" : "string"
          },
          "netSum" : {
            "type" : "number"
          },
          "postingCount" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "DepositRequest" : {
        "description" : "Request to credit a customer account from the currency's CLEARING account",
        "properties" : {
          "amount" : {
            "description" : "Positive deposit amount in minor units",
            "example" : 50000.0,
            "minimum" : 0.01,
            "type" : "number"
          },
          "currency" : {
            "description" : "ISO 4217 currency code matching the account",
            "example" : "NAD",
            "maxLength" : 3,
            "minLength" : 3,
            "type" : "string"
          },
          "reference" : {
            "description" : "Audit reference for the deposit",
            "example" : "DEP-BANK-WINDHOEK-20261107",
            "maxLength" : 160,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "amount", "currency", "reference" ],
        "type" : "object"
      },
      "FxQuoteResponse" : {
        "properties" : {
          "buyAmount" : {
            "type" : "number"
          },
          "buyCurrency" : {
            "type" : "string"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "expiresAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "midRate" : {
            "type" : "number"
          },
          "rate" : {
            "type" : "number"
          },
          "sellAmount" : {
            "type" : "number"
          },
          "sellCurrency" : {
            "type" : "string"
          },
          "spread" : {
            "type" : "number"
          },
          "usedAt" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "FxRatesResponse" : {
        "description" : "Indicative exchange rates from one base currency. Not a quote: nothing is locked.",
        "properties" : {
          "asOf" : {
            "description" : "When the rates were read from the rate source",
            "format" : "date-time",
            "type" : "string"
          },
          "base" : {
            "example" : "EUR",
            "type" : "string"
          },
          "rates" : {
            "items" : {
              "$ref" : "#/components/schemas/Rate"
            },
            "type" : "array"
          },
          "source" : {
            "description" : "Where the rates come from",
            "example" : "static-configuration",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "HoldResponse" : {
        "description" : "A hold: funds reserved on the payer account, then captured or released",
        "properties" : {
          "amount" : {
            "description" : "Charge amount, in the charge currency",
            "type" : "number"
          },
          "captureJournalEntryId" : {
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "capturedAmount" : {
            "type" : [ "number", "null" ]
          },
          "capturedPayerAmount" : {
            "type" : [ "number", "null" ]
          },
          "closedAt" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "currency" : {
            "type" : "string"
          },
          "expiresAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "fxRate" : {
            "description" : "Locked rate for a cross-currency hold: 1 payer currency = fxRate charge currency",
            "type" : [ "number", "null" ]
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "payerAccountId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "payerAccountNumber" : {
            "type" : "string"
          },
          "payerAmount" : {
            "description" : "Amount reserved on the payer account, in its currency",
            "type" : "number"
          },
          "payerCurrency" : {
            "type" : "string"
          },
          "reference" : {
            "type" : "string"
          },
          "status" : {
            "enum" : [ "ACTIVE", "CAPTURED", "RELEASED", "EXPIRED" ],
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "JournalEntryResponse" : {
        "description" : "Immutable double-entry journal entry with balanced postings",
        "properties" : {
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "entryType" : {
            "enum" : [ "DEPOSIT", "TRANSFER", "FX_TRANSFER", "REVERSAL", "CAPTURE" ],
            "type" : "string"
          },
          "fxQuoteId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "fxRate" : {
            "type" : "number"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "postings" : {
            "items" : {
              "$ref" : "#/components/schemas/PostingResponse"
            },
            "type" : "array"
          },
          "reference" : {
            "type" : "string"
          },
          "reversesEntryId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "PostingResponse" : {
        "description" : "Single signed posting within a journal entry",
        "properties" : {
          "accountId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "accountNumber" : {
            "type" : "string"
          },
          "amount" : {
            "type" : "number"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "currency" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "runningBalance" : {
            "type" : "number"
          }
        },
        "type" : "object"
      },
      "ProblemDetail" : {
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "format" : "uri",
            "type" : "string"
          },
          "properties" : {
            "additionalProperties" : { },
            "type" : "object"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Rate" : {
        "properties" : {
          "currency" : {
            "description" : "Quote currency",
            "example" : "NAD",
            "type" : "string"
          },
          "customerRate" : {
            "description" : "Rate a conversion from base would use: midRate x (1 - spread)",
            "example" : 19.9,
            "type" : "number"
          },
          "midRate" : {
            "description" : "Mid-market rate: 1 base = midRate quote currency",
            "example" : 20.0,
            "type" : "number"
          },
          "spread" : {
            "description" : "Spread banking applies when it converts",
            "example" : 0.005,
            "type" : "number"
          }
        },
        "type" : "object"
      },
      "ReconciliationReportResponse" : {
        "properties" : {
          "accountsChecked" : {
            "format" : "int32",
            "type" : "integer"
          },
          "balanced" : {
            "type" : "boolean"
          },
          "checkedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "discrepancies" : {
            "items" : {
              "$ref" : "#/components/schemas/AccountDiscrepancy"
            },
            "type" : "array"
          },
          "trialBalances" : {
            "items" : {
              "$ref" : "#/components/schemas/CurrencyTrialBalance"
            },
            "type" : "array"
          }
        },
        "type" : "object"
      },
      "ReversalRequest" : {
        "description" : "Optional reason when reversing a journal entry",
        "properties" : {
          "reason" : {
            "description" : "Reason for reversing the entry",
            "example" : "Duplicate booking charge correction",
            "maxLength" : 160,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "StatementLineResponse" : {
        "description" : "Account statement line with running balance after the posting",
        "properties" : {
          "amount" : {
            "type" : "number"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "currency" : {
            "type" : "string"
          },
          "entryType" : {
            "enum" : [ "DEPOSIT", "TRANSFER", "FX_TRANSFER", "REVERSAL", "CAPTURE" ],
            "type" : "string"
          },
          "journalEntryId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "postingId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "reference" : {
            "type" : "string"
          },
          "runningBalance" : {
            "type" : "number"
          }
        },
        "type" : "object"
      },
      "StatementPageResponse" : {
        "description" : "Keyset-paginated account statement (newest first)",
        "properties" : {
          "accountId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "accountNumber" : {
            "type" : "string"
          },
          "currency" : {
            "type" : "string"
          },
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/StatementLineResponse"
            },
            "type" : "array"
          },
          "nextCursor" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "TransferResponse" : {
        "description" : "Executed ledger transfer and its double-entry postings",
        "properties" : {
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "fxQuoteId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "fxRate" : {
            "type" : "number"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "journalEntryId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "postings" : {
            "items" : {
              "$ref" : "#/components/schemas/PostingResponse"
            },
            "type" : "array"
          },
          "reference" : {
            "type" : "string"
          },
          "sourceAccountId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "sourceAccountNumber" : {
            "type" : "string"
          },
          "sourceAmount" : {
            "type" : "number"
          },
          "sourceCurrency" : {
            "type" : "string"
          },
          "targetAccountId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "targetAccountNumber" : {
            "type" : "string"
          },
          "targetAmount" : {
            "type" : "number"
          },
          "targetCurrency" : {
            "type" : "string"
          }
        },
        "type" : "object"
      }
    }
  },
  "info" : {
    "contact" : {
      "name" : "FreightFlow",
      "url" : "https://github.com/tsegale/cross-border-logistics-system"
    },
    "description" : "Multi-currency accounts (NAD, ZAR, EUR), append-only double-entry ledger, idempotent transfers and FX quotes on the Walvis Bay to Hamburg corridor.",
    "title" : "FreightFlow Banking Service API",
    "version" : "1.0.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/accounts" : {
      "post" : {
        "operationId" : "createAccount",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "examples" : {
                "Namibian exporter account" : {
                  "description" : "Namibian exporter account",
                  "value" : {
                    "currency" : "NAD",
                    "holderReference" : "CUST-NAM-WALVIS-001"
                  }
                }
              },
              "schema" : {
                "$ref" : "#/components/schemas/CreateAccountRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "example" : {
                  "accountNumber" : "FF83NAD000001000",
                  "balance" : 0.0,
                  "createdAt" : "2026-11-07T18:00:00Z",
                  "currency" : "NAD",
                  "holderReference" : "CUST-NAM-WALVIS-001",
                  "id" : "01930000-0000-7000-8000-000000001000",
                  "status" : "ACTIVE",
                  "type" : "CUSTOMER",
                  "updatedAt" : "2026-11-07T18:00:00Z"
                },
                "schema" : {
                  "$ref" : "#/components/schemas/AccountResponse"
                }
              }
            },
            "description" : "Customer account created"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Validation error or unsupported currency"
          }
        },
        "summary" : "Open a customer ledger account",
        "tags" : [ "Accounts" ]
      }
    },
    "/api/v1/accounts/{id}" : {
      "get" : {
        "operationId" : "getAccount",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AccountResponse"
                }
              }
            },
            "description" : "Account details"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Mistyped account number (MOD 97-10 check failed)"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Account not found"
          }
        },
        "summary" : "Get a ledger account by UUIDv7 id or check-digit account number",
        "tags" : [ "Accounts" ]
      }
    },
    "/api/v1/accounts/{id}/deposits" : {
      "post" : {
        "operationId" : "deposit",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Idempotency-Key header",
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "example" : {
                "amount" : 50000.0,
                "currency" : "NAD",
                "reference" : "DEP-BANK-WINDHOEK-001"
              },
              "schema" : {
                "$ref" : "#/components/schemas/DepositRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JournalEntryResponse"
                }
              }
            },
            "description" : "Deposit journal entry recorded"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid amount, currency or missing Idempotency-Key"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
