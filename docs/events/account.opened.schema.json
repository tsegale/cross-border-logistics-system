{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freightflow.dev/events/account.opened.schema.json",
  "title": "account.opened",
  "description": "A customer account was opened. Carries no account number: consumers that show one ask banking.",
  "x-topic": "freightflow.account.v1",
  "x-producer": "banking-service",
  "x-consumers": [],
  "$ref": "envelope.schema.json",
  "properties": {
    "type": {
      "const": "account.opened"
    },
    "schemaVersion": {
      "enum": [
        1
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountId",
        "organizationId",
        "accountType",
        "currency",
        "status"
      ],
      "properties": {
        "accountId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "organizationId": {
          "description": "The owning organisation.",
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "accountType": {
          "type": "string",
          "enum": [
            "CUSTOMER",
            "CLEARING",
            "FREIGHT_REVENUE",
            "FX_POSITION"
          ]
        },
        "currency": {
          "$ref": "common.schema.json#/$defs/currency"
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "FROZEN",
            "CLOSED"
          ]
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "01938a6e-2f11-7c5d-9e6f-708192a3b4c5",
      "type": "account.opened",
      "schemaVersion": 1,
      "occurredAt": "2026-11-20T08:15:02.481Z",
      "aggregateId": "01938a6e-2f10-7b4c-8d5e-6f708192a3b4",
      "sequence": 1,
      "actor": {
        "subject": "6a1f0c2e-3b4d-4e5f-8a9b-0c1d2e3f4a5b",
        "clientId": "freightflow-web",
        "organizationId": "0b3c4d5e-6f70-4812-9a3b-4c5d6e7f8091"
      },
      "requestId": "3f9a1c2b-5d4e-4f60-8a7b-9c0d1e2f3a4b",
      "payload": {
        "accountId": "01938a6e-2f10-7b4c-8d5e-6f708192a3b4",
        "organizationId": "0b3c4d5e-6f70-4812-9a3b-4c5d6e7f8091",
        "accountType": "CUSTOMER",
        "currency": "EUR",
        "status": "ACTIVE"
      }
    }
  ]
}
